{
  "binette": "0.1",
  "type": "settings",
  "sections": [
    { "priority": -1, "label": "表示", "type": "element", "component": "theme" },
    {
      "priority": 10,
      "label": "アプリ",
      "type": "list",
      "contents": [
        {
          "id": "hello",
          "start": "👋",
          "label": "サンプル",
          "sections": [
            { "type": "element", "entry": "hello" }
          ]
        }
      ]
    }
  ],
  "assets": {
    "hello": {
      "type": "js",
      "content": "export function mount(el, sh) { const p = document.createElement('p'); p.textContent = 'Station の settings.bina から差し込んだ設定です。'; const button = document.createElement('button'); button.type = 'button'; button.textContent = 'サンプルを開く'; const open = () => sh.navigate('/hello'); button.addEventListener('click', open); el.append(p, button); return () => button.removeEventListener('click', open); }"
    }
  }
}
